Algoritmo IntercambioDePalabras
	Definir A, B, temp Como Cadena
    Escribir "Ingrese la primera palabra (A):"
    Leer A
    Escribir "Ingrese la segunda palabra (B):"
    Leer B
    temp <- A
    A <- B
    B <- temp
    Escribir "El nuevo valor de A es: ", A
    Escribir "El nuevo valor de B es: ", B
FinAlgoritmo
