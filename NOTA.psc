Algoritmo NOTA
	Definir nota1, nota2, nota3, nota4, definitiva Como Real
	
    Escribir "Ingrese la nota 1 del estudiante: "
    Leer nota1
	
    Escribir "Ingrese la nota 2 del estudiante: "
    Leer nota2
	
    Escribir "Ingrese la nota 3 del estudiante: "
    Leer nota3
	
    Escribir "Ingrese la nota 4 del estudiante: "
    Leer nota4
	
    definitiva <- (nota1 + nota2 + nota3 + nota4) / 4
	
    Escribir "La definitiva es: ", definitiva
	
FinAlgoritmo
